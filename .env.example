# ============================================================
#  PREMIERE GROUP — environment configuration (EXAMPLE)
#  Copy to  .env  and fill in real values. NEVER commit  .env
#  (.env is already in .gitignore).
#
#  Read by the PHP backend (api/lib/Env.php parses this file).
#  The frontend must NEVER see any of these values.
# ============================================================

# --- Application ---
APP_ENV=production            # local | production
APP_DEBUG=false               # true only on local; must be false in production
APP_URL=https://app.example.com
APP_TIMEZONE=Asia/Makassar    # WITA / UTC+8 — do not change without a reason

# --- Database (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=premiere_group
DB_USERNAME=premiere_app
DB_PASSWORD=

# --- Auth / session ---
# 32+ random bytes, hex. Generate:  php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
SESSION_LIFETIME_MIN=10080     # 7 days
SESSION_COOKIE_SECURE=true     # true when served over HTTPS
SESSION_COOKIE_SAMESITE=Lax

# --- File uploads (selfies) ---
# Leave BLANK to use the shipped, deny-listed  storage/uploads  folder (fine for
# most hosts). Set an absolute path OUTSIDE public_html only if your plan allows
# it and that folder is writable by PHP. See docs/DEPLOYMENT.md.
UPLOAD_DIR=
UPLOAD_MAX_BYTES=2097152       # 2 MB per selfie photo
UPLOAD_ALLOWED_MIME=image/jpeg,image/png
# Todo-report attachments (photos + PDF/Office/text/CSV). Keep this <= the
# smaller of php.ini upload_max_filesize / post_max_size.
ATTACH_MAX_BYTES=10485760     # 10 MB per attachment

# --- CORS (only if the frontend is served from a different origin) ---
# Leave empty if index.html/admin.html are served from the same domain as the API.
CORS_ALLOWED_ORIGINS=
