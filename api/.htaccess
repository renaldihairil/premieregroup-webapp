# ============================================================
#  PREMIERE GROUP API — Apache / LiteSpeed rewrite + hardening
#  Every path under /api/ that is not a real file is handled by index.php.
#  Works whether the app sits at the domain root or in a subfolder
#  (no hardcoded RewriteBase).
# ============================================================
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never expose the PHP source of the internals.
  RewriteRule ^(lib|routes)/ - [F,L]

  # Real files (index.php, setup.php, .htaccess) are served directly;
  # every virtual route (/api/bootstrap, /api/overtime/start, ...) -> front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.php [QSA,L]
</IfModule>

# Fallback for hosts without mod_rewrite: at least keep internals unreadable.
<FilesMatch "\.(env|sql|md|log|ini)$">
  Require all denied
</FilesMatch>

# Do not let the .env or lock files be fetched even if placed here by mistake.
<FilesMatch "^(\.env|\.setup-lock)">
  Require all denied
</FilesMatch>
