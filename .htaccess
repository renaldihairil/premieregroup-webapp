# ============================================================
#  PREMIERE GROUP — web root  (goes in the site's document root)
#  Clean-URL SPA:
#    /            /absensi  /todo …   -> index.html   (employee app)
#    /admin       /admin/dashboard …  -> admin.html   (Admin Panel)
#    /api/…                           -> api/.htaccess handles it
#  Real files (assets, uploads via /api, .well-known) are served as-is.
# ============================================================

Options -Indexes
DirectoryIndex index.html

# ---- Never serve source, docs, DB dumps, env, or runtime data ----
RedirectMatch 404 (?i)^/(database|docs|tools|\.git)(/|$)
RedirectMatch 404 (?i)^/storage(/|$)

<FilesMatch "(?i)\.(env|sql|md|log|ini|bat|ps1|sh|lock|example)$">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)^(\.env|\.gitignore|composer\.(json|lock)|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>

# ---- Clean-URL routing ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Leave the API alone — api/.htaccess routes it.
  RewriteRule ^api(/|$) - [L]

  # 1b. Canonical: drop the .html from the two entry pages.
  RewriteRule ^admin\.html$ /admin [R=301,L]
  RewriteRule ^index\.html$ / [R=301,L]

  # 2. Any real file or directory is served directly (assets, favicon,
  #    .well-known, admin.html / index.html when requested by name, …).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Everything under /admin -> the Admin Panel shell.
  RewriteRule ^admin(/.*)?$ admin.html [L]

  # 4. Everything else -> the employee app shell.
  RewriteRule ^ index.html [L]
</IfModule>

# Fallback if mod_rewrite is unavailable: at least the two entry pages work
# at /admin.html and /index.html directly.

# ---- Force HTTPS (uncomment once your SSL certificate is active) ----
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---- Web App Manifest MIME type ----
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# ---- Caching: long for fingerprinted assets, none for the HTML shells ----
<IfModule mod_headers.c>
  <FilesMatch "(?i)\.(css|js|png|jpg|jpeg|gif|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(?i)\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # The service worker and manifests must always be revalidated so a new
  # release is picked up promptly (they are NOT ?v=NN fingerprinted).
  <FilesMatch "(?i)^(sw\.js|.*\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
